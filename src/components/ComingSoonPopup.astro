---
import { site } from '../data/site';

const nextUrl = `${site.url}/?notify=1`;
---

<div class="cs-popup" data-coming-soon hidden>
  <div class="cs-popup-backdrop" data-cs-close></div>
  <div
    class="cs-popup-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cs-popup-title"
  >
    <button type="button" class="cs-popup-close" data-cs-close aria-label="Close">×</button>
    <img
      class="cs-popup-media"
      src={site.comingSoonPopup}
      alt=""
      width="1024"
      height="512"
    />
    <div class="cs-popup-body">
      <h2 id="cs-popup-title">Be part of our journey from the very beginning.</h2>
      <p>
        Leave your name and email, and we’ll personally notify you as soon as our grand opening
        date is announced.
      </p>
      <p>We can't wait to welcome you and share this special moment with you!</p>

      <form
        class="cs-popup-form"
        method="POST"
        action={`https://formsubmit.co/${site.email}`}
        data-cs-form
      >
        <input type="hidden" name="_subject" value="VAKAMOO — Coming Soon Notify Me" />
        <input type="hidden" name="_next" value={nextUrl} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />

        <label class="sr-only" for="cs-name">Name</label>
        <input id="cs-name" name="name" type="text" placeholder="Your Full Name" required />

        <label class="sr-only" for="cs-email">Email</label>
        <input id="cs-email" name="email" type="email" placeholder="Email" required />

        <button class="btn" type="submit">¡Notify me please!</button>
      </form>
    </div>
  </div>
</div>

<script>
  import { createFocusTrap } from '../scripts/focus-trap.js';

  const KEY = 'vakamoo-coming-soon-dismissed';
  const root = document.querySelector('[data-coming-soon]');

  if (root) {
    const dialog = root.querySelector('.cs-popup-dialog');
    const trap = dialog ? createFocusTrap(dialog) : null;
    const params = new URLSearchParams(window.location.search);

    if (params.get('notify') === '1') {
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
    }

    function openPopup() {
      try {
        if (localStorage.getItem(KEY) === '1') return;
      } catch {}
      root.hidden = false;
      document.body.classList.add('cs-open');
      const closeBtn = root.querySelector('[data-cs-close].cs-popup-close');
      trap?.activate(closeBtn);
    }

    function closePopup() {
      trap?.deactivate();
      root.hidden = true;
      document.body.classList.remove('cs-open');
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
    }

    root.querySelectorAll('[data-cs-close]').forEach((el) => {
      el.addEventListener('click', closePopup);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.hidden) closePopup();
    });

    root.querySelector('[data-cs-form]')?.addEventListener('submit', () => {
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
    });

    document.addEventListener('vakamoo:cookies-ready', () => {
      setTimeout(openPopup, 350);
    });
  }
</script>
