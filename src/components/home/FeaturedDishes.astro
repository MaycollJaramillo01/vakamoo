---
import { dishes } from '../../data/site';
---

<section class="section featured-section">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Our Menu</p>
      <h2>Classic Recipes and Special <span class="accent">Delightful Dishes.</span></h2>
      <p class="lead">
        Savor timeless classics and unique dishes, crafted with passion to delight every
        discerning palate daily.
      </p>
    </div>

    <div class="featured-grid reveal">
      {
        dishes.map((dish) => (
          <article class="featured-card">
            <div class="featured-card-top">
              <h3>{dish.name}</h3>
              <span class="featured-card-price">{dish.price}</span>
            </div>
            <p>{dish.description}</p>
          </article>
        ))
      }
    </div>

    <div class="stack-lg reveal">
      <a class="btn" href="/menu/">All Menu</a>
    </div>
  </div>
</section>
