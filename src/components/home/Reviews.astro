---
import { reviews } from '../../data/site';
---

<section class="section reviews-section">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{reviews.eyebrow}</p>
      <h2>Hear from Our Satisfied <span class="accent">Client.</span></h2>
    </div>
  </div>
  <div class="reviews-marquee reveal">
    <div class="reviews-track">
      <div class="reviews-set">
        {
          reviews.items.map((item) => (
            <blockquote class="review-card">
              <p>“{item.quote}”</p>
              <footer>
                <strong>{item.name}</strong>
                <span>{item.role}</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
      <div class="reviews-set" aria-hidden="true">
        {
          reviews.items.map((item) => (
            <blockquote class="review-card">
              <p>“{item.quote}”</p>
              <footer>
                <strong>{item.name}</strong>
                <span>{item.role}</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </div>
</section>
