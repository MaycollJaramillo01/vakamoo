---
import { site } from '../../data/site';
---

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img
      src={site.heroImage}
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
    />
  </div>
  <p class="hero-watermark" aria-hidden="true">VAKAMOO</p>
  <div class="container">
    <div class="hero-content">
      <img
        class="hero-logo"
        src={site.logo}
        alt={site.name}
        width="280"
        height="127"
      />
      <h1>Japanese & Caribbean Fusion</h1>
      <p class="support accent-line">Two cultures. One Kitchen. Endless flavor.</p>
      <p class="support">
        Come and taste the fusion, where Asia meets the Caribbean.<br />
        Perfect blend of Sushi and Sazón.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/menu/">View Menu</a>
        <a
          class="btn btn-opentable"
          href="https://www.opentable.com/r/vakamoo-reservations-sykesville?restref=1548472&lang=en-US&ot_source=Restaurant%20website"
          target="_blank"
          rel="noopener"
        >Reserve on OpenTable</a>
      </div>
    </div>
  </div>
  <span class="hero-scroll" aria-hidden="true">Scroll</span>
</section>
