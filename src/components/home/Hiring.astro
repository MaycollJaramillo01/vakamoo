---
import { site } from '../../data/site';
---

<section class="hiring">
  <div class="hiring-media" aria-hidden="true">
    <img
      src={site.hiringBg}
      alt=""
      width="1024"
      height="512"
      loading="lazy"
    />
  </div>
  <div class="container hiring-inner reveal">
    <div class="hiring-panel">
      <p class="eyebrow">Careers</p>
      <h2>Now Hiring All Positions.</h2>
      <p>
        Send your resume or fill out an application.
        <strong> Be part of something big from day one.</strong>
      </p>
      <a class="btn" href="/join-us/">Apply Now!</a>
    </div>
  </div>
</section>
