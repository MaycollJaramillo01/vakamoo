---
import { site, menuCategories } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/">
          <img src={site.logo} alt={site.name} width="140" height="64" />
        </a>
        <p class="footer-blurb">
          Crafted with passion and artistic flair, each dish delivers a heartfelt culinary experience
          that blends creativity, flavor, and unforgettable satisfaction.
        </p>
        <div class="social">
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.174 2.097 15.943 2 14.643 2 11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4z"
              ></path>
            </svg>
          </a>
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm11 1.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3>Popular Food</h3>
        <ul>
          {menuCategories.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Useful Links</h3>
        <ul>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/menu/">Our Menu</a></li>
          <li><a href="/contact-us/">Contact Us</a></li>
          <li><a href="/join-us/">Join Us</a></li>
        </ul>
      </div>

      <div>
        <h3>Contact Info</h3>
        <ul>
          <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
              {site.address}<br />{site.addressLine2}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>Copyright © {new Date().getFullYear()} {site.name}. All Rights Reserved.</p>
      <div class="footer-legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-and-conditions/">Terms & Conditions</a>
        <a href="/cookies-policy/">Cookies Policy</a>
      </div>
    </div>
  </div>
</footer>
