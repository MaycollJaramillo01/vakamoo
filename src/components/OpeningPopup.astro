---
import { closureNotice } from '../data/site';
---

<div class="opening-root" data-opening-root data-hide-from={closureNotice.hideFrom} hidden>
  <div class="opening-backdrop" data-opening-backdrop></div>
  <div
    class="opening-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="opening-title"
    data-opening-panel
  >
    <div class="opening-inner">
      <button type="button" class="opening-close" data-opening-close aria-label="Close">
        ×
      </button>
      <p class="opening-kicker">{closureNotice.eyebrow}</p>
      <h2 id="opening-title">{closureNotice.title}</h2>
      <p class="opening-intro">{closureNotice.intro}</p>
      <div class="opening-date-box">
        <p class="opening-date">{closureNotice.date}</p>
      </div>
      <p class="opening-resume">{closureNotice.resume}</p>
      <p class="opening-apology">{closureNotice.apology}</p>
      <p class="opening-thanks">{closureNotice.thanks}</p>
    </div>
  </div>
</div>

<script>
  import { createFocusTrap } from '../scripts/focus-trap.js';

  const KEY = 'vakamoo-closed-2026-09-07';
  const TIMEZONE = 'America/New_York';
  const root = document.querySelector('[data-opening-root]');

  function todayStamp() {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: TIMEZONE,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());
  }

  function signalReady() {
    root?.setAttribute('data-ready', '');
    document.dispatchEvent(new CustomEvent('vakamoo:opening-ready'));
  }

  if (root) {
    const panel = root.querySelector('[data-opening-panel]');
    const trap = panel ? createFocusTrap(panel) : null;
    const hideFrom = root.getAttribute('data-hide-from');
    const expired = Boolean(hideFrom && todayStamp() >= hideFrom);

    function hide() {
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* ignore */
      }
      trap?.deactivate();
      root.hidden = true;
      document.body.classList.remove('opening-open');
      signalReady();
    }

    function show() {
      root.hidden = false;
      document.body.classList.add('opening-open');
      const closeBtn = root.querySelector('[data-opening-close]');
      trap?.activate(closeBtn);
    }

    root.querySelectorAll('[data-opening-close]').forEach((el) => {
      el.addEventListener('click', hide);
    });
    root.querySelector('[data-opening-backdrop]')?.addEventListener('click', hide);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.hidden) hide();
    });

    let seen = false;
    try {
      seen = localStorage.getItem(KEY) === '1';
    } catch {
      seen = false;
    }

    if (expired || seen) {
      signalReady();
    } else {
      show();
    }
  } else {
    document.dispatchEvent(new CustomEvent('vakamoo:opening-ready'));
  }
</script>
