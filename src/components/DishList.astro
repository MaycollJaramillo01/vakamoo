---
interface Dish {
  name: string;
  price: string;
  image: string;
  description: string;
}

interface Props {
  dishes: Dish[];
}

const { dishes } = Astro.props;
---

<div class="dish-list">
  {
    dishes.map((dish) => (
      <article class="dish">
        <img src={dish.image} alt={dish.name} width="280" height="200" loading="lazy" />
        <div>
          <h3>{dish.name}</h3>
          <p>{dish.description}</p>
        </div>
        <div class="dish-price">{dish.price}</div>
      </article>
    ))
  }
</div>
