---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ArchFrame from '../components/ArchFrame.astro';
import { site, positions } from '../data/site';
---

<SiteLayout
  title={`Join Us – ${site.name}`}
  description={`Careers at ${site.name}. Apply for kitchen and front-of-house roles in Eldersburg, MD.`}
  current="/join-us/"
>
  <PageHero
    eyebrow="Careers"
    title='Now Hiring <span class="accent">All Positions.</span>'
    lead="Send your resume or fill out an application. Be part of something big from day one."
  />

  <section class="section">
    <div class="container form-narrow">
      <ArchFrame class="form-frame reveal">
        <form class="form form-in-arch form-disabled" aria-disabled="true">
          <fieldset disabled>
            <div class="form-row">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" />
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" />
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" />
              </div>
              <div class="field">
                <label for="position">Position</label>
                <select id="position" name="position">
                  <option value="">Select a role</option>
                  {positions.map((p) => <option value={p}>{p}</option>)}
                </select>
              </div>
            </div>
            <div class="field">
              <label for="cv">CV / Resume</label>
              <input id="cv" name="cv" type="file" accept=".pdf,.doc,.docx,.png,.jpg" />
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="Tell us a little about yourself"></textarea>
            </div>
            <label class="check">
              <input type="checkbox" name="privacy_accepted" value="yes" />
              <span>
                I have read and agree to the{' '}
                <a href="/privacy-policy/" class="link-underline">Privacy Policy</a>.
              </span>
            </label>
            <button class="btn" type="button" disabled>Submit Application</button>
          </fieldset>
        </form>
      </ArchFrame>
    </div>
  </section>
</SiteLayout>
