---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import Chef from '../components/home/Chef.astro';
import FeaturedDishes from '../components/home/FeaturedDishes.astro';
import Hiring from '../components/home/Hiring.astro';
import Gallery from '../components/home/Gallery.astro';
import OrderCta from '../components/home/OrderCta.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import Reviews from '../components/home/Reviews.astro';
import Faqs from '../components/home/Faqs.astro';
import { site } from '../data/site';
---

<SiteLayout
  title={`${site.name} – Japanese x Caribbean Fusion`}
  description={site.description}
  current="/"
>
  <Hero />
  <Chef />
  <FeaturedDishes />
  <Hiring />
  <Gallery />
  <OrderCta />
  <WhyChoose />
  <Reviews />
  <Faqs />
</SiteLayout>
